{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fetchproof/r29-workbook-linkage-v1",
  "title": "R29 workbook row linkage register",
  "type": "object",
  "additionalProperties": false,
  "required": ["registerVersion", "profile", "rows"],
  "properties": {
    "registerVersion": { "const": "1.0.0" },
    "profile": { "const": "researcher-benchmark-c14n-v1" },
    "rows": { "type": "array", "minItems": 24, "maxItems": 24, "items": { "$ref": "#/$defs/row" } }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?![A-Za-z]:)(?!\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\u0000)[^\\\\\\r\\n]+$" },
    "link": {
      "type": "object", "additionalProperties": false,
      "required": ["artifactId", "recordId", "recordHash", "payloadSha256", "memberKey", "memberHash"],
      "properties": {
        "artifactId": { "enum": ["R29-01", "R29-02", "R29-03", "R29-04", "R29-05", "R29-06"] },
        "recordId": { "$ref": "#/$defs/id" }, "recordHash": { "$ref": "#/$defs/hash" },
        "payloadSha256": { "$ref": "#/$defs/hash" }, "memberKey": { "$ref": "#/$defs/id" },
        "memberHash": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] }
      }
    },
    "warm": {
      "type": "object", "additionalProperties": false,
      "required": ["artifactId", "recordId", "recordHash", "payloadSha256", "memberKey", "memberHash", "memberState", "warmScopeReason"],
      "properties": {
        "artifactId": { "const": "R29-05" }, "recordId": { "$ref": "#/$defs/id" },
        "recordHash": { "$ref": "#/$defs/hash" }, "payloadSha256": { "$ref": "#/$defs/hash" },
        "memberKey": { "$ref": "#/$defs/id" }, "memberHash": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
        "memberState": { "enum": ["PRESENT", "NOT-APPLICABLE"] }, "warmScopeReason": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 256 }, { "type": "null" }] }
      }
    },
    "lock": {
      "type": "object", "additionalProperties": false,
      "required": ["artifactId", "recordId", "recordHash", "payloadSha256", "memberKey", "memberHash", "predecessorClosureHash"],
      "properties": {
        "artifactId": { "const": "R29-06" }, "recordId": { "$ref": "#/$defs/id" },
        "recordHash": { "$ref": "#/$defs/hash" }, "payloadSha256": { "$ref": "#/$defs/hash" },
        "memberKey": { "$ref": "#/$defs/id" }, "memberHash": { "$ref": "#/$defs/hash" }, "predecessorClosureHash": { "$ref": "#/$defs/hash" }
      }
    },
    "row": {
      "type": "object", "additionalProperties": false,
      "required": ["taskId", "worksheetPath", "worksheetHash", "track", "rowVersion", "links", "rowStatus", "ownerId", "independentVerifierId", "lastVerifiedAt", "blockerIds", "rollbackRecordId"],
      "properties": {
        "taskId": { "$ref": "#/$defs/id" }, "worksheetPath": { "$ref": "#/$defs/path" }, "worksheetHash": { "$ref": "#/$defs/hash" },
        "track": { "enum": ["Frozen", "Live"] }, "rowVersion": { "const": "1.0.0" },
        "links": {
          "type": "object", "additionalProperties": false, "required": ["task", "gold", "source", "calibration", "warm", "lock"],
          "properties": {
            "task": { "$ref": "#/$defs/link" }, "gold": { "$ref": "#/$defs/link" }, "source": { "$ref": "#/$defs/link" },
            "calibration": { "$ref": "#/$defs/link" }, "warm": { "$ref": "#/$defs/warm" }, "lock": { "$ref": "#/$defs/lock" }
          }
        },
        "rowStatus": { "enum": ["PASS", "INCOMPLETE", "FAIL", "REOPEN"] }, "ownerId": { "$ref": "#/$defs/id" },
        "independentVerifierId": { "$ref": "#/$defs/id" }, "lastVerifiedAt": { "type": "string", "minLength": 20, "maxLength": 40 },
        "blockerIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "rollbackRecordId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }
      }
    }
  }
}
