{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fetchproof/role-roster-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "rosterSha256", "assignments"],
  "properties": {
    "schema": { "type": "integer", "const": 1 },
    "rosterSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["principalId", "roleId", "package", "scope", "validFrom", "approval"],
        "properties": {
          "principalId": { "type": "string", "minLength": 1 },
          "roleId": { "type": "string", "minLength": 1 },
          "package": { "type": "string", "enum": ["R28", "R29", "R30", "R31", "R32", "*"] },
          "scope": { "type": "string", "minLength": 1 },
          "validFrom": { "type": "string", "minLength": 1 },
          "validUntil": { "type": "string", "minLength": 1 },
          "approval": { "type": "object", "minProperties": 1 }
        }
      }
    }
  }
}
