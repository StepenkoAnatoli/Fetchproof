# The corpus's line endings are integrity, not style.
#
# A capture's body hash is taken over the LF bytes the collector fetched. git's smudge
# filter rewrites every text file on a default Windows checkout (core.autocrlf=true), so
# without this file the whole corpus fails `body-unmodified` on arrival with nothing
# actually wrong with it. This file outranks a reader's core.autocrlf. See ADR-0020.

research/raw/* text eol=lf
*.jsonl text eol=lf
research/*.md text eol=lf
